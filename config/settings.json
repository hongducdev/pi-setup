    "extensions\\subagents-pi",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-advisor-flow",
    "npm:pi-mcp-adapter",
    "npm:pi-lens",
    "npm:pi-model-fallback",
    "extensions\\pi-goal-orch",
    "npm:pi-skillful"
